<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="WaiterMission">
  <BehaviorTree ID="WaiterMission">
    <Sequence name="WaiterCycle">

      <!-- Paso 1: Ir a posicion inicial -->
      <Sequence name="GoHome">
        <SayText text="Yendo a posicion inicial"/>
        <NavigateToPose x="{home_x}" y="{home_y}" yaw="{home_yaw}"/>
        <SayText text="En posicion de espera"/>
      </Sequence>

      <!-- Paso 2: Esperar cliente (simulado) -->
      <Sequence name="WaitForClient">
        <SayText text="Esperando cliente..."/>
        <Timeout msec="3000">
          <AlwaysSuccess/>
        </Timeout>
        <SayText text="Cliente detectado!"/>
      </Sequence>

      <!-- Paso 3: Tomar el pedido -->
      <Sequence name="TakeOrder">
        <SayText text="Hola! Soy su camarero robot"/>

        <Sequence name="GetBeverage">
          <ListenText recognized_text="{recognized_text}"/>
          <ExtractInfo interest="bebida" full_text="{recognized_text}" extracted_info="{bebida}"/>
          <SayText text="Bebida anotada: {bebida}"/>
        </Sequence>

        <Sequence name="GetFood">
          <ListenText recognized_text="{recognized_text}"/>
          <ExtractInfo interest="comida" full_text="{recognized_text}" extracted_info="{comida}"/>
          <SayText text="Comida anotada: {comida}"/>
        </Sequence>

        <SayText text="Pedido completo: {bebida} y {comida}"/>
      </Sequence>

      <!-- Paso 4: Ir a la cocina -->
      <Sequence name="GoToKitchen">
        <SayText text="Yendo a la cocina"/>
        <NavigateToPose x="{kitchen_x}" y="{kitchen_y}" yaw="{kitchen_yaw}"/>
        <SayText text="Llegue a la cocina"/>
      </Sequence>

      <!-- Paso 5: Recoger pedido (simulado) -->
      <Sequence name="PickUpOrder">
        <SayText text="Recogiendo pedido..."/>
        <Timeout msec="3000">
          <AlwaysSuccess/>
        </Timeout>
        <SayText text="Pedido recogido!"/>
      </Sequence>

      <!-- Paso 6: Volver al cliente -->
      <Sequence name="ReturnToClient">
        <SayText text="Volviendo al cliente"/>
        <NavigateToPose x="{client_x}" y="{client_y}" yaw="{client_yaw}"/>
        <SayText text="Aqui tiene su pedido!"/>
      </Sequence>

      <!-- Paso 7: Entregar -->
      <Sequence name="DeliverOrder">
        <SayText text="Entregando pedido..."/>
        <Timeout msec="3000">
          <AlwaysSuccess/>
        </Timeout>
        <SayText text="Buen provecho!"/>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>